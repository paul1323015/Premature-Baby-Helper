  })"><pre><span class="pl-k">const</span> <span class="pl-s1">autoprefixer</span> <span class="pl-c1">=</span> <span class="pl-en">require</span><span class="pl-kos">(</span><span class="pl-s">'autoprefixer'</span><span class="pl-kos">)</span>
