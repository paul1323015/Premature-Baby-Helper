  width: -moz-available;
  width: -webkit-fill-available;
  width: stretch;
}"><pre>::<span class="pl-c1">-moz-placeholder</span> {
  <span class="pl-c1">color</span><span class="pl-kos">:</span> gray;
}
::<span class="pl-c1">placeholder</span> {
  <span class="pl-c1">color</span><span class="pl-kos">:</span> gray;
}

